FROM node:20-alpine

RUN apk add --no-cache ffmpeg python3 py3-pip curl openssl && \
    pip3 install --break-system-packages yt-dlp

WORKDIR /app

# Install frontend dependencies and build static assets
COPY frontend/package*.json frontend/pnpm-lock.yaml* ./frontend/
RUN npm install -g pnpm@9 && cd frontend && pnpm install

COPY frontend ./frontend
RUN cd frontend && pnpm build

# Install backend dependencies and build
COPY package*.json pnpm-lock.yaml* ./
COPY prisma ./prisma/
RUN pnpm install

COPY . .

RUN pnpm prisma generate && pnpm build

EXPOSE 3000

CMD ["sh", "-c", "if [ -n \"$DATABASE_URL\" ]; then npx prisma db push --skip-generate && npx tsx prisma/seed.ts; fi && node dist/server.js"]
